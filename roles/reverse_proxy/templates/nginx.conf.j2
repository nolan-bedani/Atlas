# ══════════════════════════════════════════════
# Rôle : reverse_proxy — configuration principale nginx
# Fichier géré par Ansible — NE PAS MODIFIER À LA MAIN
# ══════════════════════════════════════════════

user www-data;
worker_processes auto;
pid /run/nginx.pid;
include /etc/nginx/modules-enabled/*.conf;

events {
    worker_connections 768;
}

http {
    # ─── Paramètres de base ───
    sendfile on;
    tcp_nopush on;
    types_hash_max_size 2048;
    server_tokens off;

    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # ─── Journaux ───
    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;

    # ─── Compression gzip ───
    gzip on;
    gzip_types text/plain text/css application/javascript application/json text/javascript application/xml;

    # ─── Limitation de débit (anti-abus) ───
    limit_req_zone $binary_remote_addr zone=atlas_limit:10m rate=10r/s;

    # ─── Inclusion des configurations additionnelles ───
    include /etc/nginx/conf.d/*.conf;
    include /etc/nginx/sites-enabled/*;
}
