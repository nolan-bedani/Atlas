# ══════════════════════════════════════════════
# Rôle : grafana — provisioning de la source de données Zabbix
# Fichier géré par Ansible — toute modification manuelle sera écrasée
# ══════════════════════════════════════════════
apiVersion: 1

datasources:
  - name: Zabbix
    type: alexanderzobnin-zabbix-datasource
    uid: zabbix          # uid stable : référencé par les dashboards provisionnés
    access: proxy
    url: "http://{{ grafana_zabbix_host }}:{{ grafana_zabbix_port }}/api_jsonrpc.php"
    isDefault: true
    editable: false
    jsonData:
      username: Admin
      trends: true
    secureJsonData:
      password: "{{ vault_zabbix_admin_password }}"
