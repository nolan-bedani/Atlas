          "group": { "filter": "Atlas" },
          "host": { "filter": "$host" },
          "application": { "filter": "" },
          "itemTag": { "filter": "" },
          "item": { "filter": "/System uptime/" },
          "functions": [],
          "options": { "showDisabledItems": false }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
