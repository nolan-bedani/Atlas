{
  "__commentaire": "Dashboard Atlas — géré par Ansible (rôle grafana), ne pas modifier manuellement",
  "uid": "atlas-overview",
  "title": "Atlas — Vue d'ensemble",
  "tags": ["atlas", "pra-dr"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "time": { "from": "now-3h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Machine",
        "type": "query",
        "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "zabbix" },
        "query": { "queryType": "host", "group": "Atlas", "host": "/.*/" },
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Disponibilité de l'agent",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "zabbix" },
      "targets": [
        {
          "refId": "A",
          "queryType": "0",
          "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "zabbix" },
          "group": { "filter": "Atlas" },
          "host": { "filter": "$host" },
          "application": { "filter": "" },
          "itemTag": { "filter": "" },
          "item": { "filter": "/Zabbix agent availability/" },
          "functions": [],
          "options": { "showDisabledItems": false }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "EN LIGNE", "color": "green" }, "0": { "text": "INCONNU", "color": "orange" }, "2": { "text": "HORS LIGNE", "color": "red" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Uptime",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "alexanderzobnin-zabbix-datasource", "uid": "zabbix" },
      "targets": [
        {
          "refId": "A",
          "queryType": "0",
