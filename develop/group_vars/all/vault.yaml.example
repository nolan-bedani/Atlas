---
# ══════════════════════════════════════════════
# Vault Projet Atlas — SECRETS
# ══════════════════════════════════════════════
# ⚠️  Ce fichier est EXCLU du Git (.gitignore).
# ⚠️  Après avoir renseigné les valeurs, le chiffrer avec :
#     ansible-vault encrypt develop/group_vars/all/vault.yaml
#     (AES-256, mot de passe dans .vault_pass — lui aussi gitignored)

# ─── API Proxmox ───
# Authentification par jeton API (recommandé, révocable) :
#   pveum user token add root@pam ansible --privsep 0
# OU par mot de passe : remplacer les lignes token par vault_proxmox_password.
vault_proxmox_host: "138.201.135.108"
vault_proxmox_user: "root@pam"
vault_proxmox_token_id: "ansible"
vault_proxmox_token_secret: "CHANGE_ME"
# vault_proxmox_password: "CHANGE_ME"

# ─── MariaDB ───
vault_mariadb_root_password: "CHANGE_ME"

# ─── GLPI (connexion base de données) ───
vault_glpi_db_host: "10.30.0.10"
vault_glpi_db_name: "glpi_db"
vault_glpi_db_user: "glpi_user"
vault_glpi_db_password: "CHANGE_ME"

# ─── Zabbix (connexion base de données) ───
vault_zabbix_db_password: "CHANGE_ME"

# ─── Zabbix (compte Admin du frontend — utilisé par Grafana et l'API) ───
vault_zabbix_admin_password: "CHANGE_ME"

# ─── Grafana (compte admin) ───
vault_grafana_admin_password: "CHANGE_ME"

# ─── GLPI (jeton API du compte glpi — données de démonstration) ───
vault_glpi_api_token: "CHANGE_ME"
