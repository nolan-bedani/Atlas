---
# ══════════════════════════════════════════════
# Vault Projet Atlas — SECRETS
# ══════════════════════════════════════════════
# ⚠️  Ce fichier est EXCLU du Git (.gitignore).
# ⚠️  Après avoir renseigné les valeurs, le chiffrer avec :
#     ansible-vault encrypt develop/group_vars/all/vault.yaml
#     (AES-256, mot de passe dans .vault_pass — lui aussi gitignored)

# ─── API Proxmox ───
# Authentification par jeton API (recommandé, révocable).
#
# Moindre privilège (CLAUDE.md) : NE PAS utiliser root@pam avec --privsep 0
# (le jeton hériterait alors de tous les pouvoirs root sur l'hyperviseur).
# Créer un utilisateur dédié, un rôle restreint aux opérations LXC, puis un
# jeton AVEC séparation de privilèges (--privsep 1) :
#   pveum role add AtlasProvision -privs \
#     "VM.Allocate VM.Config.Disk VM.Config.CPU VM.Config.Memory \
#      VM.Config.Network VM.Config.Options VM.PowerMgmt \
#      Datastore.AllocateSpace Datastore.Audit"
#   pveum user add ansible@pve
#   pveum aclmod / -user ansible@pve -role AtlasProvision
#   pveum user token add ansible@pve atlas --privsep 1
#   pveum acl modify / -user 'ansible@pve!atlas' -role AtlasProvision
# OU par mot de passe : remplacer les lignes token par vault_proxmox_password.
#
# NB : ne mettez aucune valeur réelle (IP, compte, id de jeton) dans ce fichier
# .example, qui EST versionné — uniquement des placeholders CHANGE_ME.
vault_proxmox_host: "CHANGE_ME"            # ex : IP/FQDN de l'API Proxmox (VLAN 90)
vault_proxmox_user: "CHANGE_ME"            # ex : ansible@pve  (PAS root@pam)
vault_proxmox_token_id: "CHANGE_ME"        # ex : atlas
vault_proxmox_token_secret: "CHANGE_ME"
# vault_proxmox_password: "CHANGE_ME"

# ─── MariaDB ───
vault_mariadb_root_password: "CHANGE_ME"

# ─── GLPI (connexion base de données) ───
vault_glpi_db_host: "10.30.0.10"
vault_glpi_db_name: "glpi_db"
vault_glpi_db_user: "glpi_user"
vault_glpi_db_password: "CHANGE_ME"

# ─── Zabbix (connexion base de données) ───
vault_zabbix_db_password: "CHANGE_ME"

# ─── Zabbix (compte Admin du frontend — super-admin, API d'automatisation) ───
vault_zabbix_admin_password: "CHANGE_ME"

# ─── Zabbix (compte de service Grafana — lecture seule, moindre privilège) ───
# Compte dédié « grafana » créé par le rôle zabbix ; la datasource Grafana
# l'utilise au lieu du super-admin Admin.
vault_zabbix_grafana_password: "CHANGE_ME"

# ─── Grafana (compte admin) ───
vault_grafana_admin_password: "CHANGE_ME"

# ─── GLPI (compte super-administrateur — remplace le couple par défaut glpi/glpi) ───
# Mot de passe fort (>= 12 caractères). Le compte « glpi » est renommé en
# glpi_admin_username (défaut : atlasadmin) et reçoit ce mot de passe.
vault_glpi_admin_password: "CHANGE_ME"

# ─── GLPI (jeton API du compte super-admin — données de démonstration) ───
vault_glpi_api_token: "CHANGE_ME"
